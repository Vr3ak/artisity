# Copy to .env.local. Values come from `npx supabase status` (local stack only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
# Local Realtime rejects publishable keys on the websocket, so chat needs the local ANON_KEY JWT.
# Leave unset for hosted projects.
NEXT_PUBLIC_SUPABASE_REALTIME_KEY=your-local-anon-key
# Server only (never NEXT_PUBLIC_): used by /account/delete to remove the user and their files.
SUPABASE_SECRET_KEY=your-local-secret-key
# Public site origin for metadata, e.g. https://artisity.co
SITE_URL=http://localhost:3000
# Optional: the Google OAuth client id (same as Supabase's Google provider). When set, Google's own
# sign-in button is used, so Google's account chooser names this site instead of the Supabase domain.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
