# Copy to .env.local. Values come from `npx supabase status` (local stack only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
# Local Realtime rejects publishable keys on the websocket, so chat needs the local ANON_KEY JWT.
# Leave unset for hosted projects.
NEXT_PUBLIC_SUPABASE_REALTIME_KEY=your-local-anon-key
